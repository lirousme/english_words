# Use a different value for every application hosted on this domain.
APP_SESSION_NAME=subdrill_session
# Optional: set this only when a reverse proxy exposes the app at a different
# public path than PHP reports in SCRIPT_NAME (for example /english_words).
# Leave it blank when the app is served directly; the path is detected.
APP_BASE_PATH=
APP_ENV=production

DB_HOST=127.0.0.1
DB_NAME=subdrill
DB_USER=
DB_PASS=

# AI used by Words > Descobrir traduções and Gerar mais. Choose: gemini or openrouter.
AI_PROVIDER=gemini

# Gemini configuration (required when AI_PROVIDER=gemini).
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TRANSLATION_MODEL=gemini-3.5-flash-lite

# OpenRouter configuration (required when AI_PROVIDER=openrouter).
# API_KEY is also accepted for compatibility, but OPENROUTER_API_KEY is preferred.
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# Set this to any model available in your OpenRouter account.
OPENROUTER_TRANSLATION_MODEL=

GOOGLE_CLOUD_API_KEY=
